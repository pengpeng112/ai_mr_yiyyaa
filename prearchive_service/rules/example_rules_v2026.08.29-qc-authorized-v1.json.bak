      "type": "missing_doc",
      "trigger": {
        "patient_has": "surgery",
        "evidence": {
          "surgery_evidence": "sm_itf_entry"
        }
      },
      "expect": [
        "手术安全核查表",
        "手术护理记录单"
      ],
      "match": {
        "sources": [
          "sm_itf",
          "jhemr_blws"
        ],
        "by": "report_name_fuzzy",
        "vocab": {
          "手术安全核查表": [
            "安全核查单",
            "核查单",
            "核查表",
            "手术安全核查"
          ],
