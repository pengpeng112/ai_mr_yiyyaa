            "手术护理单",
            "手术护理记录"
          ]
        },
        "exclude_vocab": [
          "知情同意",
          "查房记录"
        ],
        "template_field": "progress_template_name"
      },
      "severity": "medium",
      "deduct_ref": 1.0,
      "enabled": true,
      "version": "2026.08.27-dev",
      "dept_codes": [],
      "exempt": {
        "scenes": [
          "日间手术"
        ]
      },
      "min_hours_after_event": 2,
      "require_source_ready": true,
